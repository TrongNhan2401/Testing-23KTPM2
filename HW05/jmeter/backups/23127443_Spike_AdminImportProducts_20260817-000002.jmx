          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor - Generate Products JSON" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonOutput

def count = (vars.get(&quot;product_count&quot;) ?: &quot;5&quot;) as int
def prefix = vars.get(&quot;product_prefix&quot;) ?: &quot;ImportProduct&quot;
def categoryId = (vars.get(&quot;category_id&quot;) ?: &quot;1&quot;) as int

def products = []
for (def i = 1; i &lt;= count; i++) {
    products.push([
        &quot;name&quot;: &quot;${prefix}_${i}_${System.currentTimeMillis()}&quot;,
        &quot;price&quot;: (Math.random() * 900000).intValue() + 100000,
        &quot;description&quot;: &quot;Spike test product ${i}&quot;,
        &quot;imageUrl&quot;: &quot;&quot;,
        &quot;category_id&quot;: categoryId
    ])
}

vars.put(&quot;products_json&quot;, JsonOutput.toJson([&quot;products&quot;: products]))</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223PreProcessor>
