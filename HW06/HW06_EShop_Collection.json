          "pm.request.headers.upsert({\r",
          "    key: \"X-Student-Id\",\r",
          "    value: studentId\r",
          "});\r",
          "\r",
          "console.log(`[Pre-request Script] Set Header X-Student-Id: ${studentId}`);\r",
          ""
        ]
      }
