          "const studentId = pm.environment.get(\"student_id\") || \"23127443\";",
          "pm.request.headers.upsert({",
          "    key: \"X-Student-Id\",",
          "    value: studentId",
          "});",
          "console.log(`[Pre-request Script] Set Header X-Student-Id: ${studentId}`);"
        ]
