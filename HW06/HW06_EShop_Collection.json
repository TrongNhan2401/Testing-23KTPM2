  "item": [
    {
      "name": "Auth Setup",
      "item": [
        {
          "name": "New Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login User thành công\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property(\"token\");\r",
                  "    \r",
                  "    // Tự động lưu Token vào Environment Variable user_token\r",
                  "    pm.environment.set(\"user_token\", jsonData.token);\r",
                  "    console.log(\"--> Đã tự động lưu user_token vào Environment!\");\r",
                  "});\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"test@eshop.com\",\r\n  \"password\": \"Test1234!\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            }
          },
          "response": []
        },
